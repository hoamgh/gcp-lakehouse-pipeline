# Google Cloud Configuration
PROJECT_ID=your-gcp-project-id
REGION=asia-southeast1

# Google Cloud Storage
GCS_BUCKET=your-gcp-project-id-lakehouse

# Pub/Sub Configuration
SUBSCRIPTION_ID=ecommerce-events-sub

# Authentication
SERVICE_ACCOUNT_NAME=elt-pipeline-sa
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json
GCP_CREDENTIALS_FILE=your-service-account-key.json

# Airflow/Postgres secrets (required by docker compose)
POSTGRES_PASSWORD=replace-with-a-strong-password
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-a-strong-password
AIRFLOW_FERNET_KEY=generate-with-python-c-airflow-fernet-key

# Environment
PIPELINE_ENV=gcs

# Gold reconciliation thresholds (relative differences, e.g. 0.05 = 5%)
RECON_COUNT_WARN_PCT=0.01
RECON_COUNT_FAIL_PCT=0.05
RECON_VALUE_WARN_PCT=0.001
RECON_VALUE_FAIL_PCT=0.01
